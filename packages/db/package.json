{
  "name": "@fitzindustries/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./support": {
      "types": "./src/support.ts",
      "default": "./src/support.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "push": "pnpm with-env drizzle-kit push",
    "seed:support": "pnpm with-env node src/scripts/seed-support.mjs",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "destroy-db": "docker compose down --volumes",
    "reset-db": "pnpm destroy-db && docker compose up -d --wait && pnpm push",
    "start-db": "docker compose up -d",
    "start-db-hard": "docker compose up -d --build",
    "stop-db": "docker compose down",
    "generate": "drizzle-zero generate --output ../zero-shared/src/schema.ts --format",
    "postinstall": "pnpm generate"
  },
  "dependencies": {
    "@fitzindustries/zero-shared": "workspace:*",
    "@rocicorp/zero": "catalog:",
    "drizzle-orm": "^0.44.7",
    "drizzle-zero": "^0.17.3",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fitzindustries/eslint-config": "workspace:*",
    "@fitzindustries/prettier-config": "workspace:*",
    "@fitzindustries/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@fitzindustries/prettier-config"
}
