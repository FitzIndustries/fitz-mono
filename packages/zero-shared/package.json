{
  "name": "@fitzindustries/zero-shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./expo-sqlite": {
      "types": "./src/expo-sqlite.ts",
      "default": "./src/expo-sqlite.ts"
    },
    "./zero": {
      "types": "./src/zero.ts",
      "default": "./src/zero.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@fitzindustries/db": "workspace:*",
    "@rocicorp/zero": "catalog:",
    "drizzle-zero": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fitzindustries/eslint-config": "workspace:*",
    "@fitzindustries/prettier-config": "workspace:*",
    "@fitzindustries/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@fitzindustries/prettier-config"
}
