    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@fitzindustries/eslint-config": "workspace:*",
    "@fitzindustries/prettier-config": "workspace:*",
    "@fitzindustries/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
