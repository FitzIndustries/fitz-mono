{
  "name": "fitz-mono",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @fitzindustries/auth generate",
    "dev": "turbo watch dev --continue",
    "zero-cache:dev": "turbo run zero-cache-dev --filter @fitzindustries/zero-cache",
    "dev:next": "turbo watch dev -F @fitzindustries/nextjs...",
    "postinstall": "pnpm lint:ws",
    "ui-add": "turbo run ui-add",
    "\n========== Mobile Apps ==========": "",
    "expo:start": "pnpm --filter @fitzindustries/expo start",
    "expo:android": "pnpm --filter @fitzindustries/expo android",
    "expo:ios": "pnpm --filter @fitzindustries/expo ios",
    "expo:web": "pnpm --filter @fitzindustries/expo web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "\n========== Lint & Format ==========": "",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "typecheck": "turbo run typecheck",
    "\n========== drizzle ==========": "",
    "db:generate": "pnpm --filter @fitzindustries/db db:generate",
    "db:migrate": "pnpm --filter @fitzindustries/db db:migrate",
    "db:push": "turbo -F @fitzindustries/db push",
    "db:studio": "turbo -F @fitzindustries/db studio",
    "\n========== Database ==========": "",
    "destroy-db": "pnpm run stop-db && rimraf .sst/storage/postgres",
    "start-db": "pnpm --filter @fitzindustries/db start-db",
    "start-db-hard": "pnpm --filter @fitzindustries/db start-db-hard",
    "stop-db": "pnpm --filter @fitzindustries/db stop-db"
  },
  "devDependencies": {
    "@fitzindustries/prettier-config": "workspace:*",
    "@turbo/gen": "^2.5.8",
    "dotenv-cli": "^10.0.0",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@fitzindustries/prettier-config"
}
