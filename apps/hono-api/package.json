{
  "name": "@fitzindustries/hono-api",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch ./src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node ./dist/index.js",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fitzindustries/api": "workspace:*",
    "@fitzindustries/auth": "workspace:*",
    "@fitzindustries/db": "workspace:*",
    "@fitzindustries/zero-shared": "workspace:*",
    "@hono/node-server": "^1.19.15",
    "@hono/trpc-server": "^0.3.4",
    "@t3-oss/env-core": "^0.13.8",
    "@trpc/server": "catalog:",
    "hono": "^4.7.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fitzindustries/eslint-config": "workspace:*",
    "@fitzindustries/prettier-config": "workspace:*",
    "@fitzindustries/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.20.5",
    "typescript": "catalog:"
  },
  "prettier": "@fitzindustries/prettier-config"
}
