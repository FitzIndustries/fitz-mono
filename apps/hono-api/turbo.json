{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true
    },
    "test:tenant-queries": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TEST_POSTGRES_URL"]
    }
  }
}
